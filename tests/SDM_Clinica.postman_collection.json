  "item": [
    {
      "name": "01 Login veterinário ativo",
      "item": [
        {
          "name": "Login ana (ativa/confirmada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@clinica.vet\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// gera CPF válido aleatório e microchip aleatório",
                  "let n=[...Array(9)].map(()=>Math.floor(Math.random()*10));",
                  "for(let k=0;k<2;k++){let s=n.reduce((a,d,i)=>a+d*(n.length+1-i),0);let r=(s*10)%11;n.push(r==10?0:r);}",
                  "pm.collectionVariables.set('cpf', n.join(''));",
                  "pm.collectionVariables.set('chip', '076'+[...Array(12)].map(()=>Math.floor(Math.random()*10)).join(''));",
                  "pm.collectionVariables.set('hoje', new Date().toISOString().slice(0,10));"
                ]
              }
            }
          ]
        }
      ]
    },
