erDiagram
    ENDERECO ||--o{ TUTOR : "localiza"
    TUTOR ||--o{ ANIMAL : "é responsável por"
    ESPECIE ||--o{ RACA : "agrupa"
    ESPECIE ||--o{ ANIMAL : "classifica"
    RACA |o--o{ ANIMAL : "define (opcional)"
    ANIMAL ||--o{ VINCULO_MICROCHIP : "possui histórico"
    VETERINARIO ||--o{ VINCULO_MICROCHIP : "realiza vínculo"
    VINCULO_MICROCHIP |o--o| VINCULO_MICROCHIP : "substituído por"
    ANIMAL ||--o{ CONSULTA : "recebe"
    VETERINARIO ||--o{ CONSULTA : "atende"
    ANIMAL ||--o{ VACINA : "recebe"
    VETERINARIO ||--o{ VACINA : "aplica"
    ANIMAL ||--o{ INTEGRACAO_GOVERNO : "é sincronizado"
    VACINA |o--o| INTEGRACAO_GOVERNO : "gera comunicação"
